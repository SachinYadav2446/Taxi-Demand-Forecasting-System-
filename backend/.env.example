DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/taxidemand?sslmode=disable
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External Data API Keys
# Get your keys from:
# - OpenWeatherMap: https://openweathermap.org/api (Free: 1,000 calls/day)
# - Ticketmaster: https://developer.ticketmaster.com/ (Free: 5,000 calls/day)
# - MTA: No key needed (public API)
# - AviationStack: https://aviationstack.com/ (Optional: Free tier 100 calls/month)

OPENWEATHER_API_KEY=your_openweather_key_here
TICKETMASTER_API_KEY=your_ticketmaster_key_here
MTA_API_KEY=
AVIATIONSTACK_API_KEY=your_aviationstack_key_here
